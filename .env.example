# baari: Firebase web config. Copy to .env.local and restart `npm run dev`.
#
# The values below run the whole app against the local Firebase emulators
# (`npx firebase emulators:start`), no Google account needed. A "demo-" project
# id tells the Firebase SDKs and CLI that the project only exists locally.
#
# For a real project: Firebase console > Project settings > General > Your apps
# > Web app > SDK setup and configuration ("Config"), copy each value here and
# set NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false. These keys identify the project
# to the browser; they are not secrets. Access is controlled by firestore.rules.

NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-baari.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-baari
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-baari.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# "true" connects Auth and Firestore to the local emulators instead of Google.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Hostname of the Firestore emulator, without a port (the app always uses 8080,
# as in firebase.json). To test from a tablet or phone on the same Wi-Fi, use
# your computer's LAN IP here and below (README: "Trying it on a real tablet").
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1

# Full URL of the Auth emulator, with its port.
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
